# ==============================================
# YAGA Social - Environment Variables Template
# ==============================================

# Neo4j Database Configuration
NEO4J_URI=bolt://yaga-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_neo4j_password_2026

# RustFS (S3 Compatible Storage) Configuration
RUSTFS_ENDPOINT=http://yaga-rustfs:9000
RUSTFS_ACCESS_KEY=change_this_rustfs_access_key
RUSTFS_SECRET_KEY=change_this_rustfs_secret_key
RUSTFS_BUCKET=social-media-assets

# JWT Security Configuration
JWT_ISSUER=https://yaga-social.com/issuer

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
